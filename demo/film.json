{
  "version": "jirex.film/1",
  "meta": {
    "title": "The Keeper",
    "author": "jireX",
    "description": "A lighthouse keeper and her neighbour turn a seized lamp by hand so four boats can find their way home.",
    "fps": 24,
    "width": 1280,
    "height": 720
  },

  "voices": {
    "mara_v": { "spec": "tts:en_GB-alba-medium" },
    "jonas_v": { "spec": "tts:en_GB-alan-medium" }
  },

  "palettes": {
    "dusk": {
      "sky_hi": "#17233f", "sky_lo": "#c4663a", "sea": "#101c2a", "rock": "#15181d",
      "tower": "#d9d3c7", "tower_dark": "#9a9387", "lamp_off": "#3b3a38", "lamp_on": "#ffd98a",
      "skin": "#e8c39e", "coat": "#b23a2c", "coat2": "#2e4a6b", "hair": "#2b1d14",
      "eye": "#15110e", "shoe": "#1c1410", "trouser": "#26303a", "brass": "#c9933f",
      "glass": "#9fd0e0", "stone": "#2a2b30", "stone_hi": "#3b3d45", "night": "#0b1120"
    }
  },

  "characters": {
    "mara": {
      "palette": "dusk",
      "voice": "mara_v",
      "generate": { "cloth": "coat", "trouser": "trouser", "hair": "hair" },
      "proportions": { "height": 196 },
      "poses": {
        "stand":   { "torso": { "rot": 0 },      "armL": { "rot": 0.10 }, "armR": { "rot": -0.10 }, "head": { "rot": 0 } },
        "look_up": { "torso": { "rot": -0.04 },  "head": { "rot": -0.30 }, "armL": { "rot": 0.16 }, "armR": { "rot": -0.16 } },

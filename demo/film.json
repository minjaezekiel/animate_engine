        "heave":   { "torso": { "rot": 0.20 },   "armL": { "rot": -1.05 }, "armR": { "rot": -1.15 },
                     "foreL": { "rot": -0.5 },   "foreR": { "rot": -0.45 }, "head": { "rot": 0.12 } },
        "weary":   { "torso": { "rot": 0.10 },   "head": { "rot": 0.20 }, "armL": { "rot": 0.05 }, "armR": { "rot": -0.05 } }
      }
    },
    "jonas": {
      "palette": "dusk",
      "voice": "jonas_v",
      "generate": { "cloth": "coat2", "trouser": "trouser", "hair": "hair" },
